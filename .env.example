# Copie para .env e preencha. O .env nao vai para o git.

# Cifra os tokens de API guardados em Configuracoes (AES-256-GCM).
ENCRYPTION_KEY=

# Login com Google (PLT-02).
# Crie um "OAuth 2.0 Client ID" do tipo "Web application" no Google Cloud
# Console e cole o Client ID aqui. Ele e publico — aparece no HTML de
# qualquer site que use Google Sign-In. O Client Secret NAO e usado: o fluxo
# e por ID token, verificado no backend.
#
# Em "Authorized JavaScript origins", cadastre as origens de onde a pagina e
# servida:
#   http://localhost:5173     (npm run dev)
#   http://localhost           (Docker)
# "Authorized redirect URIs" fica vazio — o fluxo de ID token nao redireciona.
GOOGLE_CLIENT_ID=

# Assina a sessao. Minimo 16 caracteres; validado no boot da API.
# Gere um: openssl rand -base64 32
JWT_SECRET=

# E-mails que entram como admin, separados por virgula. Vazio = ninguem.
# Admin ve o icone de engrenagem e a area de Configuracoes.
ADMIN_EMAILS=

# LOGIN DESLIGADO (temporario). Com 'true', NENHUMA rota exige token: todo
# mundo e a conta de DEFAULT_USER_EMAIL, e /api/settings/tokens fica acessivel
# a quem alcancar a porta 3333. So use em rede local.
#
# Para religar: 'false' (ou apague a linha) + GOOGLE_CLIENT_ID preenchido.
# O codigo do login continua inteiro; nada precisa ser reescrito.
AUTH_DISABLED=true

# Servidor de e-mail do envio semanal de vagas (JOB-24).
#
# VAZIO por padrao, e isso e um estado valido: sem SMTP_HOST o provedor de
# e-mail REGISTRA NO LOG em vez de enviar, e `emailAtivo` responde false mesmo
# com o interruptor ligado em Configuracoes. Preencher aqui e o unico gesto
# que faz a mensagem sair de verdade.
SMTP_HOST=

# Base publica do site, usada nos links de um clique do e-mail (descadastrar e
# "consegui a vaga"). Sem ela os links apontam para http://localhost:5173.
APP_URL=

# Telegram como segundo canal de notificacao (JOB-32).
#
# VAZIO por padrao, e isso e um estado valido: sem TELEGRAM_BOT_TOKEN o canal
# fica INERTE — a opcao "Receber no Telegram" nao aparece na aba Jobs, a rota
# do webhook nao fica de pe, e a API avisa uma vez no boot. O e-mail continua
# funcionando normalmente.
#
# **Um bot POR AMBIENTE.** O Telegram entrega cada update a UMA url: com um bot
# so, desenvolvimento e producao roubariam as mensagens um do outro, e mensagem
# de teste chegaria a gente real. Crie um bot no @BotFather para cada um.
#
# O token que o @BotFather devolve, no formato 123456:ABC-DEF...
TELEGRAM_BOT_TOKEN=

# O @username do bot, SEM o @. E o `<bot>` do deep link t.me/<bot>?start=<token>
# que a tela abre. Muda junto com o token, por isso e variavel.
TELEGRAM_BOT_USERNAME=

# Onde o Telegram entrega os updates. Deriva de APP_URL quando vazia
# (APP_URL + /api/telegram/webhook).
#
# **Exige HTTPS**, nas portas 443, 80, 88 ou 8443 — e regra do Telegram. Em
# producao o Coolify ja entrega HTTPS; em desenvolvimento local exige um tunel
# (ngrok, cloudflared), porque o Telegram nao alcanca localhost:3333.
TELEGRAM_WEBHOOK_URL=

# Segredo do header X-Telegram-Bot-Api-Secret-Token, que e o que separa "update
# do Telegram" de "qualquer um que descobriu a URL" — a rota do webhook e
# publica por necessidade.
#
# OPCIONAL: vazio, ele e derivado do proprio TELEGRAM_BOT_TOKEN, o que ja da um
# segredo estavel e diferente por ambiente. Preencha so para gira-lo sem trocar
# de bot. Minimo 16 caracteres, so A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=

# --- Provedores de IA (opcional) ---
#
# A chave normalmente e cadastrada em Configuracoes e fica cifrada no banco
# (PLT-01). Estas variaveis sao a ALTERNATIVA por ambiente, util em
# desenvolvimento e no deploy que injeta segredo sem passar pela tela.
#
# Quatro deles tem free tier SEM CARTAO: Gemini, Groq, Cerebras e Mistral.
# Eles existem como fallback — a aplicacao percorre a cadeia ate um funcionar.
#
# ATENCAO: Gemini e Mistral TREINAM com os dados do free tier. A leitura de
# curriculo envia o texto INTEIRO do CV. A tela de Configuracoes avisa.
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#GEMINI_API_KEY=
#GROQ_API_KEY=
#CEREBRAS_API_KEY=
#MISTRAL_API_KEY=

# URL base de cada provedor. Vazia = a URL oficial dele. Serve para apontar
# para um gateway, um proxy ou um duble de teste sem mexer em codigo.
#ANTHROPIC_BASE_URL=
#OPENAI_BASE_URL=
#GEMINI_BASE_URL=
#GROQ_BASE_URL=
#CEREBRAS_BASE_URL=
#MISTRAL_BASE_URL=

# A API do freehire (JOB-38). Vazia usa https://freehire.me.
# Existe porque o freehire e open source e self-hostavel: apontar para uma
# instancia propria nao pede mudanca de codigo.
FREEHIRE_API_URL=
