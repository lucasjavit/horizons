# Copie para .env e preencha. O .env nao vai para o git.

# Cifra os tokens de API guardados em Configuracoes (AES-256-GCM).
ENCRYPTION_KEY=

# Login com Google (PLT-02).
# Crie um "OAuth 2.0 Client ID" do tipo "Web application" no Google Cloud
# Console e cole o Client ID aqui. Ele e publico — aparece no HTML de
# qualquer site que use Google Sign-In. O Client Secret NAO e usado: o fluxo
# e por ID token, verificado no backend.
#
# Em "Authorized JavaScript origins", cadastre as origens de onde a pagina e
# servida:
#   http://localhost:5173     (npm run dev)
#   http://localhost           (Docker)
# "Authorized redirect URIs" fica vazio — o fluxo de ID token nao redireciona.
GOOGLE_CLIENT_ID=

# Assina a sessao. Minimo 16 caracteres; validado no boot da API.
# Gere um: openssl rand -base64 32
JWT_SECRET=

# E-mails que entram como admin, separados por virgula. Vazio = ninguem.
# Admin ve o icone de engrenagem e a area de Configuracoes.
ADMIN_EMAILS=

# LOGIN DESLIGADO (temporario). Com 'true', NENHUMA rota exige token: todo
# mundo e a conta de DEFAULT_USER_EMAIL, e /api/settings/tokens fica acessivel
# a quem alcancar a porta 3333. So use em rede local.
#
# Para religar: 'false' (ou apague a linha) + GOOGLE_CLIENT_ID preenchido.
# O codigo do login continua inteiro; nada precisa ser reescrito.
AUTH_DISABLED=true

# Servidor de e-mail do envio semanal de vagas (JOB-24).
#
# VAZIO por padrao, e isso e um estado valido: sem SMTP_HOST o provedor de
# e-mail REGISTRA NO LOG em vez de enviar, e `emailAtivo` responde false mesmo
# com o interruptor ligado em Configuracoes. Preencher aqui e o unico gesto
# que faz a mensagem sair de verdade.
SMTP_HOST=

# Base publica do site, usada nos links de um clique do e-mail (descadastrar e
# "consegui a vaga"). Sem ela os links apontam para http://localhost:5173.
APP_URL=
