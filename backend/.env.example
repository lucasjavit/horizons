# Copie para .env e ajuste. O .env nao vai para o git.
DATABASE_URL="postgresql://horizons:horizons@localhost:5433/horizons?schema=public"
PORT=3333
CORS_ORIGIN="http://localhost:5173"

# Cifra os tokens de API guardados. Frase longa qualquer; trocar invalida
# os tokens ja salvos, que terao de ser digitados de novo.
ENCRYPTION_KEY="troque esta frase por outra bem longa e sua"

# Assina a sessao. Minimo 16 caracteres, senao a API NAO SOBE — de proposito:
# erro de configuracao do servidor nao e erro de autenticacao.
# Gere um: openssl rand -base64 32
JWT_SECRET="troque esta frase por outra bem longa e sua"

# Client ID do OAuth do Google (Web application). Publico — aparece no HTML de
# qualquer site que use Google Sign-In. Em "Authorized JavaScript origins",
# cadastre http://localhost:5173; redirect URIs fica vazio.
# Sem ele a aplicacao sobe e a tela de login explica que nao esta configurada.
GOOGLE_CLIENT_ID=

# Quem entra como admin, separado por virgula. Vazio = ninguem.
ADMIN_EMAILS=

# Desliga o login inteiro: com 'true', NENHUMA rota exige token e todo mundo e
# a conta de DEFAULT_USER_EMAIL. So use em rede local.
AUTH_DISABLED=false

# Conta usada quando AUTH_DISABLED esta ligada.
DEFAULT_USER_EMAIL=eu@horizons.local
