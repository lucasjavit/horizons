// Horizons — schema do banco.
// Modelagem generica de trilhas: uma Track (trilha) tem Modules, que tem
// Lessons. O progresso e por usuario e por licao.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: a connection string vive em prisma.config.ts (Migrate) e no
// adapter passado ao PrismaClient (runtime), nao mais aqui.
datasource db {
  provider = "postgresql"
}

model User {
  id          String     @id @default(uuid())
  email       String     @unique
  name        String
  avatarUrl   String?
  /// De onde veio a conta. Hoje so GOOGLE; o campo existe para nao precisar
  /// de migration quando houver outro provedor.
  provider    String     @default("GOOGLE")
  /// `sub` do provedor. Nulo nas contas criadas pelo guard antigo, que sao
  /// adotadas por e-mail no primeiro login (PLT-03).
  providerId  String?
  /// "USER" ou "ADMIN". String e nao enum: o tsconfig do front proibe enum de
  /// TS, e o padrao da casa para dois valores e uniao de string.
  role        String     @default("USER")
  /// Desligar aqui derruba a sessao na requisicao seguinte, sem esperar o
  /// token expirar — o guard rele o usuario a cada request.
  active      Boolean    @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  progress    Progress[]
  tokens      ApiToken[]
  jobProfile  JobProfile?
  savedJobs   SavedJob[]
  emailSub    EmailSubscription?
  telegram    TelegramLink?
  telegramConvites TelegramConvite[]
  jobHistory  JobHistory[]

  @@index([provider, providerId])
  @@map("users")
}

/// O que a pessoa procura. Um por usuario.
///
/// Alimenta o job de 50 minutos (JOB-03): ele le os perfis ativos, agrupa
/// pelos que tem a mesma assinatura e faz UMA busca por grupo.
model JobProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  /// Perfil extraido do CV: stack, senioridade, anos.
  ///
  /// NUNCA o arquivo nem o texto bruto — some o CPF, o endereco e o telefone.
  /// O arquivo e processado em memoria e descartado. Token se revoga; CPF nao.
  /// Coluna Json? recebe Prisma.DbNull, nunca null.
  cvProfile Json?
  /// Filtros no formato que o prompt de busca espera (job_titles, keywords,
  /// locations, remote, seniority, salary_min...). Todos opcionais.
  filtros   Json
  /// Assinatura dos filtros normalizados: `senioridade|stack ordenada|regiao`.
  /// Perfis com a mesma assinatura leem as mesmas vagas — uma rodada serve a
  /// todos. E o que impede N perfis virarem N buscas a cada 50 minutos.
  grupo     String
  ativo     Boolean  @default(true)
  /// Quando este perfil foi buscado pela ultima vez.
  ///
  /// A fila da busca agendada gira por aqui, e nao por `updatedAt`: aquele so
  /// muda quando a PESSOA edita o perfil, entao com mais grupos que o teto da
  /// rodada os ultimos nunca seriam atendidos (medido pelo QA em 21/08 — 5 de
  /// 15 grupos ficavam de fora para sempre). Nulo = nunca buscado, e vai na
  /// frente.
  buscadoEm DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ativo, grupo])
  @@map("job_profiles")
}

enum ApiProvider {
  ANTHROPIC
  OPENAI
  /// Busca de vagas. Nao e provedor de IA — mora aqui porque o mecanismo e o
  /// mesmo: token de terceiro, cifrado em repouso, cadastrado pelo admin.
  FIRECRAWL
}

/// Configuracao global da aplicacao, uma linha por chave.
///
/// Tabela e nao variavel de ambiente porque isto muda em tempo de execucao,
/// pelo painel de admin: religar a leitura de CV nao pode exigir redeploy.
/// Variavel de ambiente continua sendo o lugar de segredo e de coisa que
/// decide o boot.
model AppSetting {
  chave     String   @id
  valor     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

/// Vaga encontrada por uma rodada de busca.
///
/// Expira em 15 dias — e o tempo em que o processo ainda esta de pe; depois
/// disso a lista viraria colecao de link morto. Vaga que a pessoa salva sai
/// desta regra (JOB-05).
model FoundJob {
  id        String   @id @default(uuid())
  /// Assinatura do grupo (JOB-02). Uma rodada serve a todos os perfis com a
  /// mesma assinatura.
  grupo     String
  title     String
  company   String
  url       String
  /// Cidade/pais como o anuncio escreveu. Nulo quando nao diz.
  local     String?
  /// De onde a vaga veio (dominio). Busca por IA erra, e mostrar a fonte
  /// deixa a pessoa calibrar a confianca sozinha.
  fonte     String?
  /// "remoto" | "hibrido" | "presencial", ou nulo quando o anuncio nao diz.
  /// Nulo NAO vira "remoto": campo ausente permanece ausente.
  regime    String?
  /// Tecnologias citadas no anuncio.
  skills    String[]
  /// Area/familia do cargo ("Back-end Engineer"). Sai do anuncio, nao e
  /// deduzida do titulo.
  area      String?
  /// Anos de experiencia pedidos. Nulo quando o anuncio nao diz — e a
  /// maioria nao diz.
  anosExp   Int?
  /// Beneficios citados ("remote work", "health insurance").
  benefits  String[]
  /// Formacao exigida ("Bachelor's"). Nulo e o caso comum.
  degree    String?
  /// Logo da empresa. URL absoluta; a tela cai nas iniciais quando falta.
  logoUrl   String?
  /// ISO-3166 alpha-2 do pais, para a bandeirinha ("us", "br").
  paisIso   String?
  /// Retrato do momento da captura, com os trechos de origem das afirmacoes
  /// sensiveis (salario, elegibilidade) para poderem ser conferidas.
  snapshot  Json?
  postedAt  DateTime?
  foundAt   DateTime @default(now())
  expiresAt DateTime

  @@unique([grupo, url])
  @@index([grupo, foundAt])
  @@index([expiresAt])
  @@map("found_jobs")
}

/// Vaga que a pessoa guardou. **Sai da regra dos 15 dias e fica para sempre.**
///
/// Decisao do stakeholder: "nao vou querer as vagas no banco de dados, a nao
/// ser que o usuario decida guardar a vaga para ele". Por isso este modelo e
/// separado de `FoundJob` — um e cache que expira, o outro e o que a pessoa
/// escolheu manter.
///
/// **Guarda um RETRATO, nao uma referencia.** So a URL faria a lista virar
/// colecao de 404: a vaga sai do ar em semanas, e e justamente o que ela vai
/// querer reler depois. Com o snapshot, a pagina cair nao apaga a informacao,
/// e a afirmacao da IA continua auditavel contra o texto que a gerou.
model SavedJob {
  id        String   @id @default(uuid())
  userId    String
  title     String
  company   String
  url       String
  local     String?
  fonte     String?
  regime    String?
  skills    String[]
  area      String?
  anosExp   Int?
  benefits  String[]
  degree    String?
  logoUrl   String?
  paisIso   String?
  /// Salario, elegibilidade e os trechos de origem — o que torna a afirmacao
  /// conferivel depois que o anuncio sumir.
  snapshot  Json?
  postedAt  DateTime?
  /// Quando a vaga foi encontrada, nao quando foi salva: e o que a tela mostra
  /// como idade do anuncio.
  foundAt   DateTime
  savedAt   DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Salvar duas vezes nao duplica.
  @@unique([userId, url])
  @@index([userId, savedAt])
  @@map("saved_jobs")
}

/// O que a pessoa ja viu ou descartou (JOB-26). Uma linha por (usuario, vaga).
///
/// **Uma tabela com `estado`, e nao duas tabelas.** Visto e descartado sao
/// estados do MESMO par (pessoa, vaga), e nao fatos independentes: descartar
/// uma vaga implica te-la visto, e um par nao pode estar nos dois. Com duas
/// tabelas seria preciso escrever nas duas e mante-las coerentes na mao — e a
/// primeira falha de meia-transacao deixaria uma vaga descartada aparecendo
/// como nova.
///
/// **Guarda a URL, e nao um retrato.** Ao contrario de `SavedJob`, aqui nao ha
/// nada a reler: a linha so responde "esta vaga ja passou por mim?". Copiar o
/// anuncio inteiro para dizer isso encheria o banco com o que a pessoa
/// justamente NAO quer ver.
///
/// **Nao ha `FoundJob` referenciado.** A vaga expira em 15 dias e a busca ao
/// vivo nem grava; a URL e o unico identificador que sobrevive aos dois, e e o
/// mesmo que `SavedJob` ja usa como chave por usuario.
model JobHistory {
  id        String   @id @default(uuid())
  userId    String
  url       String
  /// "visto" ou "descartado". String e nao enum: o tsconfig do front proibe
  /// enum de TS, e o padrao da casa para poucos valores e uniao de string.
  estado    String
  /// Titulo e empresa no momento em que entrou no historico.
  ///
  /// **So para a tela de descartadas ter o que mostrar.** Sem isto, "ver o que
  /// eu descartei" seria uma lista de URLs cruas — ilegivel, e a pessoa nao
  /// teria como reconhecer a vaga para desfazer. Sao dois campos curtos, nao
  /// o snapshot inteiro.
  title     String
  company   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// A mesma vaga nao entra duas vezes: marcar de novo faz `upsert`.
  @@unique([userId, url])
  /// A consulta quente e "todas as marcas desta pessoa", para a tela cruzar
  /// com o resultado da busca de uma vez so.
  @@index([userId, estado])
  @@map("job_history")
}

/// A assinatura do e-mail de vagas. Uma por usuario.
///
/// Guarda tres coisas que precisam sobreviver entre um envio e o proximo:
/// **quando foi o ultimo** (para "so vagas novas desde entao"), **em que
/// cadencia** (JOB-25: quem foi contratado passa a receber uma vez por mes) e
/// o **token do link**, que e o que faz descadastrar e "consegui a vaga"
/// funcionarem sem login.
model EmailSubscription {
  id            String   @id @default(uuid())
  userId        String   @unique
  /// "semanal" ou "mensal". String e nao enum: o tsconfig do front proibe
  /// enum de TS, e o padrao da casa para poucos valores e uniao de string.
  ///
  /// `mensal` NAO e degradacao: e a cadencia de quem foi contratado e passou a
  /// querer acompanhar o mercado sem procurar (JOB-25).
  cadencia      String   @default("semanal")
  /// Recebe e-mail? Descadastrar poe `false` e nao apaga a linha — apagar
  /// perderia `ultimoEnvioEm` e o token, e quem volta atras receberia de uma
  /// vez todas as vagas dos ultimos 15 dias.
  ativo         Boolean  @default(true)
  /// Segredo do link de um clique. Aleatorio de 32 bytes em hex.
  ///
  /// Unico e indexado porque e por ele que a rota publica encontra a pessoa —
  /// sem sessao, sem e-mail na URL. E-mail na URL vazaria no Referer e deixaria
  /// qualquer um descadastrar qualquer um so adivinhando o endereco.
  token         String   @unique
  /// Quando o ultimo e-mail SAIU de fato.
  ///
  /// So avanca quando houve envio com vaga dentro: semana sem vaga nova nao
  /// mexe aqui, senao as vagas daquela semana nunca entrariam no proximo.
  ultimoEnvioEm DateTime?
  /// Quando a pessoa clicou em "consegui a vaga". Nulo = nunca clicou.
  ///
  /// Coluna propria, e nao deduzida de `cadencia == "mensal"`: e a metrica que
  /// o produto existe para produzir (quantas pessoas ele empregou), e ela nao
  /// pode sumir se a pessoa voltar a procurar depois.
  contratadoEm  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ativo, cadencia])
  @@map("email_subscriptions")
}

/// A vinculacao com o Telegram (JOB-32). Uma por usuario.
///
/// **Modelo proprio, e nao colunas em `EmailSubscription`.** Sao dois canais
/// independentes: o criterio do card pede que dar errado num nao avance o
/// carimbo do outro, e que se possa ter um ligado e o outro desligado. Com as
/// colunas juntas, `ultimoEnvioEm` seria compartilhado — uma falha no Telegram
/// faria a pessoa perder o e-mail daquela semana, ou o contrario.
///
/// A cadencia NAO se repete aqui: ela e da pessoa, nao do canal (JOB-25 diz
/// "quem foi contratado recebe uma vez por mes", e nao "por e-mail uma vez por
/// mes"). Continua morando em `EmailSubscription` e vale para os dois.
model TelegramLink {
  id            String   @id @default(uuid())
  userId        String   @unique
  /// O endereco de entrega, dado pelo proprio Telegram no `/start`.
  ///
  /// **Coluna comum, nao cifrada** (decidido em 24/08). E identificador de
  /// destino, igual ao e-mail que fica em claro na mesma feature; cifrar um e
  /// nao o outro seria incoerente, e cifrado ele nao se consulta — e por ele
  /// que se acha o vinculo. Diferente dos tokens do PLT-01, que sao
  /// credencial: sem o token do bot, um `chat_id` nao envia nada a ninguem.
  ///
  /// `BigInt` porque o `chat_id` do Telegram excede 32 bits e a documentacao
  /// avisa que pode passar de 2^53 — em `Int` ele estouraria em silencio.
  ///
  /// Unico: **o mesmo `chat_id` nao vincula a duas contas** (decidido em
  /// 24/08). Um chat recebendo vagas de dois perfis e confusao sem dono, e
  /// quem recebesse nao teria como saber de qual conta veio o que.
  chatId        BigInt   @unique
  /// @username de quem vinculou, so para a tela dizer qual conta esta ligada.
  /// Opcional porque conta de Telegram sem username existe.
  username      String?
  /// Recebe vagas pelo Telegram? Desvincular apaga a linha inteira (o
  /// criterio do card pede que o `chat_id` suma), mas bloquear o bot so
  /// desliga aqui — o vinculo continua para a pessoa poder religar.
  ativo         Boolean  @default(true)
  /// Quando a ultima mensagem SAIU de fato, por este canal.
  ///
  /// Mesma regra do e-mail: so avanca quando entregou. Provedor que nao
  /// entrega nao mexe aqui, senao no dia do token real a pessoa comecaria do
  /// zero como se as semanas anteriores tivessem chegado.
  ultimoEnvioEm DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ativo])
  @@map("telegram_links")
}

/// Um convite de vinculacao pendente — o `<token>` de `t.me/<bot>?start=<token>`.
///
/// Existe porque **o bot nao pode iniciar conversa**: o `chat_id` so passa a
/// existir depois do START, e e o token que liga aquele START a esta conta.
///
/// Tabela separada de `TelegramLink` porque o ciclo de vida e outro: o convite
/// nasce, expira em 30 minutos e morre usado; o vinculo dura. Guardar o token
/// pendente dentro do vinculo criaria uma linha de vinculo para quem so clicou
/// no botao e nunca apertou START.
model TelegramConvite {
  id        String   @id @default(uuid())
  userId    String
  /// O token do deep link. Ate 64 caracteres de `A-Z a-z 0-9 _ -` — limite do
  /// parametro `start` do Telegram. Unico: e por ele que o `/start` acha a
  /// conta.
  token     String   @unique
  /// Quando deixa de valer. Convite aberto e nao usado nao pode ficar
  /// "aguardando" para sempre, senao o botao nunca volta a oferecer vincular.
  expiraEm  DateTime
  /// Quando foi trocado por um vinculo. **Nao se apaga a linha ao usar**: e o
  /// que faz um token ja usado nao vincular uma segunda conta, em vez de
  /// simplesmente nao ser encontrado.
  usadoEm   DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiraEm])
  @@map("telegram_convites")
}

/// Token de API de um provedor de IA, cifrado em repouso.
model ApiToken {
  id        String      @id @default(uuid())
  userId    String
  provider  ApiProvider
  /// Valor cifrado (AES-256-GCM). Nunca sai da API em texto claro.
  secret    String
  /// Ultimos quatro caracteres, para a pessoa reconhecer qual token e.
  hint      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("api_tokens")
}

/// Uma trilha de estudo (ex.: System Design).
model Track {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String
  /// Emoji ou nome de icone para a listagem.
  icon        String?
  position    Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  modules     Module[]

  @@map("tracks")
}

model Module {
  id       String   @id @default(uuid())
  trackId  String
  slug     String
  title    String
  /// O que a pessoa sai sabendo depois deste modulo.
  goal     String
  position Int      @default(0)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@unique([trackId, slug])
  @@index([trackId, position])
  @@map("modules")
}

enum LessonKind {
  ARTICLE
  VIDEO
  PAPER
  COURSE
  BOOK
  CHANNEL
}

model Lesson {
  id       String     @id @default(uuid())
  moduleId String
  slug     String
  title    String
  kind     LessonKind @default(ARTICLE)
  /// Resumo de uma linha, exibido na listagem.
  summary  String?
  /// Conteudo autoral da aula, como blocos estruturados (JSON).
  content  Json?
  /// Link para a fonte original, quando houver leitura complementar.
  sourceUrl String?
  position Int        @default(0)
  module   Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress Progress[]

  @@unique([moduleId, slug])
  @@index([moduleId, position])
  @@map("lessons")
}

/// Progresso e anotacoes de um usuario numa licao.
model Progress {
  id          String    @id @default(uuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, completed])
  @@map("progress")
}
