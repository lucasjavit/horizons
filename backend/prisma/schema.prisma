// Horizons — schema do banco.
// Modelagem generica de trilhas: uma Track (trilha) tem Modules, que tem
// Lessons. O progresso e por usuario e por licao.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: a connection string vive em prisma.config.ts (Migrate) e no
// adapter passado ao PrismaClient (runtime), nao mais aqui.
datasource db {
  provider = "postgresql"
}

model User {
  id          String     @id @default(uuid())
  email       String     @unique
  name        String
  avatarUrl   String?
  /// De onde veio a conta. Hoje so GOOGLE; o campo existe para nao precisar
  /// de migration quando houver outro provedor.
  provider    String     @default("GOOGLE")
  /// `sub` do provedor. Nulo nas contas criadas pelo guard antigo, que sao
  /// adotadas por e-mail no primeiro login (PLT-03).
  providerId  String?
  /// "USER" ou "ADMIN". String e nao enum: o tsconfig do front proibe enum de
  /// TS, e o padrao da casa para dois valores e uniao de string.
  role        String     @default("USER")
  /// Desligar aqui derruba a sessao na requisicao seguinte, sem esperar o
  /// token expirar — o guard rele o usuario a cada request.
  active      Boolean    @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  progress    Progress[]
  tokens      ApiToken[]
  jobProfile  JobProfile?

  @@index([provider, providerId])
  @@map("users")
}

/// O que a pessoa procura. Um por usuario.
///
/// Alimenta o job de 50 minutos (JOB-03): ele le os perfis ativos, agrupa
/// pelos que tem a mesma assinatura e faz UMA busca por grupo.
model JobProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  /// Perfil extraido do CV: stack, senioridade, anos.
  ///
  /// NUNCA o arquivo nem o texto bruto — some o CPF, o endereco e o telefone.
  /// O arquivo e processado em memoria e descartado. Token se revoga; CPF nao.
  /// Coluna Json? recebe Prisma.DbNull, nunca null.
  cvProfile Json?
  /// Filtros no formato que o prompt de busca espera (job_titles, keywords,
  /// locations, remote, seniority, salary_min...). Todos opcionais.
  filtros   Json
  /// Assinatura dos filtros normalizados: `senioridade|stack ordenada|regiao`.
  /// Perfis com a mesma assinatura leem as mesmas vagas — uma rodada serve a
  /// todos. E o que impede N perfis virarem N buscas a cada 50 minutos.
  grupo     String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ativo, grupo])
  @@map("job_profiles")
}

enum ApiProvider {
  ANTHROPIC
  OPENAI
}

/// Configuracao global da aplicacao, uma linha por chave.
///
/// Tabela e nao variavel de ambiente porque isto muda em tempo de execucao,
/// pelo painel de admin: religar a leitura de CV nao pode exigir redeploy.
/// Variavel de ambiente continua sendo o lugar de segredo e de coisa que
/// decide o boot.
model AppSetting {
  chave     String   @id
  valor     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

/// Token de API de um provedor de IA, cifrado em repouso.
model ApiToken {
  id        String      @id @default(uuid())
  userId    String
  provider  ApiProvider
  /// Valor cifrado (AES-256-GCM). Nunca sai da API em texto claro.
  secret    String
  /// Ultimos quatro caracteres, para a pessoa reconhecer qual token e.
  hint      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("api_tokens")
}

/// Uma trilha de estudo (ex.: System Design).
model Track {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String
  /// Emoji ou nome de icone para a listagem.
  icon        String?
  position    Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  modules     Module[]

  @@map("tracks")
}

model Module {
  id       String   @id @default(uuid())
  trackId  String
  slug     String
  title    String
  /// O que a pessoa sai sabendo depois deste modulo.
  goal     String
  position Int      @default(0)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@unique([trackId, slug])
  @@index([trackId, position])
  @@map("modules")
}

enum LessonKind {
  ARTICLE
  VIDEO
  PAPER
  COURSE
  BOOK
  CHANNEL
}

model Lesson {
  id       String     @id @default(uuid())
  moduleId String
  slug     String
  title    String
  kind     LessonKind @default(ARTICLE)
  /// Resumo de uma linha, exibido na listagem.
  summary  String?
  /// Conteudo autoral da aula, como blocos estruturados (JSON).
  content  Json?
  /// Link para a fonte original, quando houver leitura complementar.
  sourceUrl String?
  position Int        @default(0)
  module   Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress Progress[]

  @@unique([moduleId, slug])
  @@index([moduleId, position])
  @@map("lessons")
}

/// Progresso e anotacoes de um usuario numa licao.
model Progress {
  id          String    @id @default(uuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, completed])
  @@map("progress")
}
