// Horizons — schema do banco.
// Modelagem generica de trilhas: uma Track (trilha) tem Modules, que tem
// Lessons. O progresso e por usuario e por licao.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: a connection string vive em prisma.config.ts (Migrate) e no
// adapter passado ao PrismaClient (runtime), nao mais aqui.
datasource db {
  provider = "postgresql"
}

model User {
  id          String     @id @default(uuid())
  email       String     @unique
  name        String
  avatarUrl   String?
  /// De onde veio a conta. Hoje so GOOGLE; o campo existe para nao precisar
  /// de migration quando houver outro provedor.
  provider    String     @default("GOOGLE")
  /// `sub` do provedor. Nulo nas contas criadas pelo guard antigo, que sao
  /// adotadas por e-mail no primeiro login (PLT-03).
  providerId  String?
  /// "USER" ou "ADMIN". String e nao enum: o tsconfig do front proibe enum de
  /// TS, e o padrao da casa para dois valores e uniao de string.
  role        String     @default("USER")
  /// Desligar aqui derruba a sessao na requisicao seguinte, sem esperar o
  /// token expirar — o guard rele o usuario a cada request.
  active      Boolean    @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  progress    Progress[]
  tokens      ApiToken[]

  @@index([provider, providerId])
  @@map("users")
}

enum ApiProvider {
  ANTHROPIC
  OPENAI
}

/// Token de API de um provedor de IA, cifrado em repouso.
model ApiToken {
  id        String      @id @default(uuid())
  userId    String
  provider  ApiProvider
  /// Valor cifrado (AES-256-GCM). Nunca sai da API em texto claro.
  secret    String
  /// Ultimos quatro caracteres, para a pessoa reconhecer qual token e.
  hint      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("api_tokens")
}

/// Uma trilha de estudo (ex.: System Design).
model Track {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String
  /// Emoji ou nome de icone para a listagem.
  icon        String?
  position    Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  modules     Module[]

  @@map("tracks")
}

model Module {
  id       String   @id @default(uuid())
  trackId  String
  slug     String
  title    String
  /// O que a pessoa sai sabendo depois deste modulo.
  goal     String
  position Int      @default(0)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@unique([trackId, slug])
  @@index([trackId, position])
  @@map("modules")
}

enum LessonKind {
  ARTICLE
  VIDEO
  PAPER
  COURSE
  BOOK
  CHANNEL
}

model Lesson {
  id       String     @id @default(uuid())
  moduleId String
  slug     String
  title    String
  kind     LessonKind @default(ARTICLE)
  /// Resumo de uma linha, exibido na listagem.
  summary  String?
  /// Conteudo autoral da aula, como blocos estruturados (JSON).
  content  Json?
  /// Link para a fonte original, quando houver leitura complementar.
  sourceUrl String?
  position Int        @default(0)
  module   Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress Progress[]

  @@unique([moduleId, slug])
  @@index([moduleId, position])
  @@map("lessons")
}

/// Progresso e anotacoes de um usuario numa licao.
model Progress {
  id          String    @id @default(uuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, completed])
  @@map("progress")
}
